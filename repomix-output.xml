              example: "/v1/enrollments/8f14e45f-ceea-467a-9a38-1b241d45b001"
            X-Request-ID:
              $ref: "#/components/headers/XRequestIdResponseHeader"
            X-Instance-Id:
              $ref: "#/components/headers/XInstanceIdResponseHeader"
          content:
