                title: "Некоректні дані запиту (Unprocessable Entity)"
                status: 422
                detail: "Поле 'group_id' є обов'язковим, не може бути порожнім або містити пробіли."
                instance: "/v1/enrollments"
                error_code: "invalid_group_id_format"
                request_id: "req-422-demo"

