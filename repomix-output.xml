          type: string
        unsafe_mode:
          type: boolean
        instance_id:
          type: string

    IntervalStats:
      type: object
      required: [description, sample_count, mean_ms, p50_ms, p95_ms, p99_ms]
      properties:
        description:
          type: string
        sample_count:
          type: integer
        mean_ms:
          type: number
        p50_ms:
          type: number
        p95_ms:
          type: number
        p99_ms:
          type: number

    ServiceMetricsResponse:
      type: object
      required: [service, instance_id, timestamp_utc, configuration, queue_length, in_processing, counters, intervals_ms, littles_law]
      properties:
        service:
          type: string
        instance_id:
          type: string
        timestamp_utc:
          type: string
          format: date-time
        configuration:
          type: object
        queue_length:
          type: integer
        in_processing:
          type: integer
        counters:
          type: object
        intervals_ms:
          type: object
          properties:
            queue_wait_ms:
              $ref: "#/components/schemas/IntervalStats"
            processing_time_ms:
              $ref: "#/components/schemas/IntervalStats"
            delivery_wait_ms:
              $ref: "#/components/schemas/IntervalStats"
            full_domain_execution_ms:
              $ref: "#/components/schemas/IntervalStats"
        littles_law:
          type: object

paths:
  /:
    get:
      operationId: getApiDiscovery
