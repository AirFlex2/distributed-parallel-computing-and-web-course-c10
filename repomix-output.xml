namespace EnrollmentService.Domain;

using EnrollmentService.Services;

public static class EnrollmentPolicy
{
    public sealed record CheckResult(
        bool Allowed,
        string? ErrorCode,
        string? RejectionReason);

    public static CheckResult Check(
        StudentEntity student,
        DisciplineGroupEntity group,
        decimal disciplineEcts,
        DateTimeOffset nowUtc,
        bool alreadyEnrolledForDiscipline)
    {
        if (group.Closed)
        {
            return new(false, "group_closed", $"Навчальна група '{group.Id}' закрита працівником деканату (closed = true).");
        }

        if (!EnrollmentDomainRules.IsWithinEnrollmentWindow(nowUtc, group.OpensAt, group.ClosesAt))
        {
            return new(false, "enrollment_window_closed", $"Запит поза часовим вікном запису на групу '{group.Id}'.");
        }

        if (alreadyEnrolledForDiscipline)
        {
            return new(false, "duplicate_discipline_enrollment", $"Студент '{student.Id}' вже має активний запис на дану дисципліну.");
        }

        if (!EnrollmentDomainRules.CanEnrollWithDisciplineLimit(student.ActiveCount, student.MaxDisciplines))
        {
            return new(false, "discipline_limit_exceeded", $"Перевищено ліміт активних дисциплін студента '{student.Id}' ({student.ActiveCount} із {student.MaxDisciplines} дозволених).");
        }

        if (!EnrollmentDomainRules.CanEnrollWithEcts(student.ActiveEcts, disciplineEcts))
        {
            decimal projectedEcts = student.ActiveEcts + disciplineEcts;
            return new(false, "ects_limit_exceeded", $"Перевищено семестровий ліміт кредитів ЄКТС студента '{student.Id}' ({projectedEcts:0.0} > {EnrollmentDomainRules.MaxSemesterEcts:0.0}).");
        }

        if (group.Available <= 0)
        {
            return new(false, "group_full", $"Вичерпано ліміт місць у навчальній групі '{group.Id}' (доступно 0 місць).");
        }

        return new(true, null, null);
    }
}
