                group_id: "DISC-WEB-01"
                discipline_id: "DISC-WEB"
                discipline_title: "Обмін даними у Web-застосунках"
                ects: 6.0
                status: "held"
                version: 1
                created_at: "2026-10-30T08:15:00Z"
                expires_at: "2026-10-30T08:30:00Z"
                created_at_local: "2026-10-30T10:15:00+02:00"
                expires_at_local: "2026-10-30T10:30:00+02:00"
                university_tz: "Europe/Kyiv"
                instance_id: "app-a"
                extra_server_field: "forward_compatible_o1_7"
        "400":
          description: Синтаксично некоректний JSON або відсутній обов'язковий заголовок X-User-Id
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/ProblemDetails"
              example:
                type: "https://urn.c10.edu.ua/problems/missing_user_header"
                title: "Відсутній обов'язковий заголовок X-User-Id"
                status: 400
                detail: "До введення автентифікації в ЛР3 ідентифікатор студента має обов'язково передаватися у заголовку X-User-Id."
                instance: "/v1/enrollments"
                error_code: "missing_user_header"
                request_id: "req-400-demo"
        "404":
          description: Навчальну групу або студента не знайдено
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/ProblemDetails"
              example:
                type: "https://urn.c10.edu.ua/problems/group_not_found"
                title: "Групу дисципліни не знайдено"
                status: 404
                detail: "Група з ідентифікатором 'DISC-UNKNOWN' не існує."
                instance: "/v1/enrollments"
                error_code: "group_not_found"
                request_id: "req-404-demo"
        "409":
          description: Конфлікт стану або недостатньо ресурсу (немає вільних місць, поза вікном [opens_at, closes_at), перевищено ліміт K або 30.0 ЄКТС)
          content:
            application/problem+json:
              schema:
                $ref: "#/components/schemas/ProblemDetails"
              example:
                type: "https://urn.c10.edu.ua/problems/ects_limit_exceeded"
                title: "Перевищено семестровий ліміт кредитів ЄКТС"
                status: 409
                detail: "Сума кредитів після запису становить 30.5 ЄКТС, що перевищує максимум 30.0 ЄКТС."
                instance: "/v1/enrollments"
                error_code: "ects_limit_exceeded"
                request_id: "req-409-demo"
        "422":
          description: Некоректні дані у валідному JSON (порожній group_id або заборонене поле student_id у тілі)
          content:
            application/problem+json:
