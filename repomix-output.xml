          type: boolean

    DecanateRosterEntry:
      type: object
      required: [request_id, student_id, group_id, discipline_id, discipline_title, ects, assignment_type, created_at]
      properties:
        request_id:
          type: string
          format: uuid
        student_id:
          type: string
        group_id:
          type: string
        discipline_id:
          type: string
        discipline_title:
          type: string
        ects:
          type: number
        enrollment_id:
          type: [string, "null"]
        assignment_type:
          type: string
        created_at:
          type: string
          format: date-time

    AdminResetResponse:
      type: object
      required: [message, unsafe_mode]
      properties:
