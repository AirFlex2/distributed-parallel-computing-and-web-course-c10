                    title: "Перевищено семестровий ліміт кредитів ЄКТС"
                    status: 422
                    detail: "Сума кредитів після запису становить 30.5 ЄКТС, що перевищує максимум 30.0 ЄКТС."
                    instance: "/v1/enrollments"
                    error_code: "ects_limit_exceeded"
                    request_id: "req-422-demo"
                idempotency_payload_mismatch:
                  summary: Повторний ключ Idempotency-Key з іншим тілом (Web О2.2)
                  value:
                    type: "https://urn.c10.edu.ua/problems/idempotency_key_payload_mismatch"
                    title: "Невідповідність корисного навантаження ключа ідемпотентності"
                    status: 422
                    detail: "Ключ Idempotency-Key вже використано для іншого запиту або іншого студента."
                    instance: "/v1/enrollments"
                    error_code: "idempotency_key_payload_mismatch"
                    request_id: "req-422-idem-demo"

