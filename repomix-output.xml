<file path="compose.yaml">
services:
  postgres:
    image: postgres:16-alpine
    container_name: dpc-c10-postgres
    environment:
      POSTGRES_USER: dpc_user
      POSTGRES_PASSWORD: dpc_password
      POSTGRES_DB: dpc_c10
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U dpc_user -d dpc_c10"]
      interval: 3s
      timeout: 3s
      retries: 10

  app-a:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: dpc-c10-api
    hostname: app-a
    networks:
      default:
        aliases:
          - api
          - app-a
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      ASPNETCORE_URLS: "http://+:8080"
      INSTANCE_ID: "app-a"
      DB_CONNECTION_STRING: "${DB_CONNECTION_STRING:-Host=postgres;Port=5432;Database=dpc_c10;Username=dpc_user;Password=dpc_password;Maximum Pool Size=20}"
      API_AUTH_TOKEN: "${API_AUTH_TOKEN:-secret-c10-token-2026}"
      QUEUE_CAPACITY: "${QUEUE_CAPACITY:-100}"
      WORKERS: "${WORKERS:-3}"
      UNSAFE_MODE: "${UNSAFE_MODE:-false}"
      EXECUTION_MODEL: "${EXECUTION_MODEL:-async_tasks}"
      QUEUE_ENGINE: "${QUEUE_ENGINE:-custom_monitor}"
      SLOW_CALL_MIN_MS: "${SLOW_CALL_MIN_MS:-200}"
      SLOW_CALL_MAX_MS: "${SLOW_CALL_MAX_MS:-700}"
      ALLOW_TEST_OVERRIDES: "${ALLOW_TEST_OVERRIDES:-false}"
      ENABLE_WORKERS: "true"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 2s
      timeout: 2s
      retries: 10
      start_period: 3s
    stop_grace_period: 60s

  app-b:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: dpc-c10-app-b
    hostname: app-b
    networks:
      default:
        aliases:
          - app-b
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      ASPNETCORE_URLS: "http://+:8080"
      INSTANCE_ID: "app-b"
      DB_CONNECTION_STRING: "${DB_CONNECTION_STRING:-Host=postgres;Port=5432;Database=dpc_c10;Username=dpc_user;Password=dpc_password;Maximum Pool Size=20}"
      API_AUTH_TOKEN: "${API_AUTH_TOKEN:-secret-c10-token-2026}"
      QUEUE_CAPACITY: "${QUEUE_CAPACITY:-100}"
      WORKERS: "${WORKERS:-3}"
      UNSAFE_MODE: "${UNSAFE_MODE:-false}"
      EXECUTION_MODEL: "${EXECUTION_MODEL:-async_tasks}"
      QUEUE_ENGINE: "${QUEUE_ENGINE:-custom_monitor}"
      SLOW_CALL_MIN_MS: "${SLOW_CALL_MIN_MS:-200}"
      SLOW_CALL_MAX_MS: "${SLOW_CALL_MAX_MS:-700}"
      ALLOW_TEST_OVERRIDES: "${ALLOW_TEST_OVERRIDES:-false}"
      ENABLE_WORKERS: "false"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 2s
      timeout: 2s
      retries: 10
      start_period: 3s
    stop_grace_period: 60s

  nginx:
    image: nginx:1.27-alpine
    container_name: dpc-c10-nginx
    depends_on:
      app-a:
        condition: service_healthy
      app-b:
        condition: service_healthy
    ports:
      - "8080:8080"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro

volumes:
  pgdata:
</file>

<file path="Dockerfile">
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/EnrollmentService/EnrollmentService.csproj ./src/EnrollmentService/
RUN dotnet restore ./src/EnrollmentService/EnrollmentService.csproj

COPY src/EnrollmentService/ ./src/EnrollmentService/
WORKDIR /src/src/EnrollmentService
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
COPY migrations/ ./migrations/

EXPOSE 8080
ENTRYPOINT ["dotnet", "EnrollmentService.dll"]
</file>

<file path="nginx.conf">
worker_processes auto;

events {
    worker_connections 2048;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/json;

    sendfile        on;
    keepalive_timeout 65;

    # О1.6 (Web): Балансування навантаження least_conn між двома безстановими екземплярами app-a та app-b
    upstream web_backend {
        least_conn;
        server app-a:8080 max_fails=2 fail_timeout=3s;
        server app-b:8080 max_fails=2 fail_timeout=3s;
        keepalive 64;
    }

    # Маршрутизація черги РПО (DPC) на головний вузол черги в пам'яті (app-a / dpc-c10-api)
    upstream dpc_backend {
        server app-a:8080 max_fails=1 fail_timeout=2s;
        keepalive 64;
    }

    server {
        listen 8080;
        server_name localhost;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header traceparent $http_traceparent;

        # Маршрути РПО із чергою в пам'яті процесів та метриками Літтла
        location /v1/enrollment-requests {
            proxy_pass http://dpc_backend;
        }

        location /v1/group-seats {
            proxy_pass http://dpc_backend;
        }

        location /v1/decanate-roster {
            proxy_pass http://dpc_backend;
        }

        location /v1/admin {
            proxy_pass http://dpc_backend;
        }

        location /metrics {
            proxy_pass http://dpc_backend;
        }

        # Прямі маршрути перевірки живучості конкретних екземплярів (О1.2, О1.6)
        location /health-app-a {
            proxy_pass http://app-a:8080/health;
        }

        location /health-app-b {
            proxy_pass http://app-b:8080/health;
        }

        # Усі маршрути Web-застосунку (/health, /v1/disciplines, /v1/enrollments, /v1/groups, /v1/students)
        # балансуються через least_conn між app-a та app-b (О1.6)
        location / {
            proxy_pass http://web_backend;
        }
    }
}
</file>

<file path="openapi.yaml">
openapi: 3.1.0
info:
  title: "C10: Запис на вибіркові дисципліни — Спільний контракт API (Web + РПО, ЛР1)"
  version: "1.2.0"
  description: |
    Єдиний контракт API у форматі OpenAPI 3.1 для спільної теми **С10 «Запис на вибіркові дисципліни»**:
    - **Курс «Обмін даними у Web-застосунках» (ЛР1: О1.1–О1.7, Д1.1–Д1.5)**:
      - Головна операція `POST /v1/enrollments` (атомарна транзакція БД поверх єдиного ресурсу `discipline_group`, `201 Created` із заголовком `Location`, помилки `400`, `404`, `409`, `422` у форматі `Problem Details` RFC 9457);
      - Обов'язковий заголовок `X-User-Id` на користувацьких маршрутах (заборона визначення власника з тіла запиту);
      - Курсорне пагінування `GET /v1/enrollments?limit=...&after=...` за парою `(created_at DESC, id DESC)`;
      - Каталог дисциплін і груп `GET /v1/disciplines` із часовим вікном `[opens_at, closes_at)` (`Europe/Kyiv`) та кредитами ЄКТС (`<= 30.0`), довідник студентів `GET /v1/students`;
      - Скасування запису `POST /v1/enrollments/{id}/cancel` та закриття групи `POST /v1/groups/{id}/close`;
      - Наскрізний `X-Request-ID` та підтримка `traceparent` (W3C Trace Context).
    - **Курс «Розподілені та паралельні обчислення» (ЛР1: О1.1–О1.5, Д1.1–Д1.4)**:
      - Приймання заявок у внутрішню обмежену чергу `POST /v1/enrollment-requests` (`202 Accepted`, відсікання перевантаження `429 Too Many Requests` + `Retry-After: 1`, `503 Service Unavailable` під час SIGTERM);
      - Опитування стану заявки `GET /v1/enrollment-requests/{id}` із одноразовою фіксацією `first_read_at`;
      - Стан спільного ресурсу через SQL-представлення `VIEW group_seats` (`GET /v1/group-seats`, `GET /v1/group-seats/{id}`) та метрики черги і закону Літтла `GET /metrics`.

servers:
  - url: http://localhost:8080
    description: Вхідна точка через балансувальник навантаження Nginx (least_conn між app-a та app-b)

tags:
  - name: Shared
    description: Спільні службові та стендові маршрути обох курсів
  - name: Web
    description: Маршрути курсу «Обмін даними у Web-застосунках» (ЛР1)
  - name: DPC
    description: Маршрути курсу «Розподілені та паралельні обчислення» (ЛР1)

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      description: Фіксований токен авторизації для маршрутів РПО (`secret-c10-token-2026`)

  parameters:
    XRequestIdHeader:
      name: X-Request-ID
      in: header
      required: false
      description: Наскрізний ідентифікатор HTTP-запиту (О1.6 Web). Якщо не передано клієнтом — генерується сервером і повертається у відповіді.
      schema:
        type: string
      example: "req-c10-2026-0001"
    XUserIdRequiredHeader:
      name: X-User-Id
      in: header
      required: true
      description: Обов'язковий ідентифікатор наперед створеного студента в БД до введення автентифікації в ЛР3 (О1.4 Web). Якщо відсутній — повертається 400 Bad Request Problem Details.
      schema:
        type: string
        minLength: 1
        maxLength: 64
      example: "student-1"
    XUserIdOptionalHeader:
      name: X-User-Id
      in: header
      required: false
      description: Опційний ідентифікатор користувача для запису в журнал запитів.
      schema:
        type: string
      example: "student-1"
    TraceparentHeader:
      name: traceparent
      in: header
      required: false
      description: Заголовок W3C Trace Context для трасування (Д1.4 Web). Валідний trace-id записується в однорядковий JSON-журнал.
      schema:
        type: string
      example: "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"

  headers:
    XRequestIdResponseHeader:
      description: Наскрізний ідентифікатор запиту (О1.6 Web)
      schema:
        type: string
    XInstanceIdResponseHeader:
      description: Ідентифікатор екземпляра додатка за балансувальником nginx (`app-a` або `app-b`)
      schema:
        type: string
        enum: [app-a, app-b]
    RetryAfterHeader:
      description: Рекомендована пауза у секундах перед повторною спробою при переповненні черги (О1.2 РПО)
      schema:
        type: string
      example: "1"

  schemas:
    ProblemDetails:
      type: object
      description: Повідомлення про помилку у форматі RFC 9457 Problem Details (application/problem+json)
      required: [type, title, status, detail, instance]
      properties:
        type:
          type: string
          format: uri
        title:
          type: string
        status:
          type: integer
        detail:
          type: string
        instance:
          type: string
        error_code:
          type: string
        request_id:
          type: string
        instance_id:
          type: string
        timestamp_utc:
          type: string
          format: date-time

    HealthResponse:
      type: object
      required: [status, instance_id, timestamp_utc, queue_length, queue_capacity, allow_test_overrides]
      properties:
        status:
          type: string
          enum: [ok, shutting_down]
        instance_id:
          type: string
        timestamp_utc:
          type: string
          format: date-time
        queue_length:
          type: integer
        queue_capacity:
          type: integer
        allow_test_overrides:
          type: boolean

    WebStudent:
      type: object
      required: [id, email, full_name, max_disciplines, active_count, active_ects, max_ects]
      properties:
        id:
          type: string
        email:
          type: string
          format: email
        full_name:
          type: string
        max_disciplines:
          type: integer
        active_count:
          type: integer
        active_ects:
          type: number
        max_ects:
          type: number

    WebStudentListResponse:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/WebStudent"

    CreateWebEnrollmentRequest:
      type: object
      required: [group_id]
      properties:
        group_id:
          type: string
          description: Рядковий ідентифікатор групи вибіркової дисципліни (посилання на discipline_group.id). Поле student_id у тілі заборонено (422).

    WebEnrollmentResponse:
      type: object
      required:
        - id
        - student_id
        - group_id
        - discipline_id
        - discipline_title
        - ects
        - status
        - version
        - created_at
        - expires_at
        - created_at_local
        - expires_at_local
        - university_tz
      properties:
        id:
          type: string
          description: Рядковий UUID запису студента на дисципліну (О1.4)
        student_id:
          type: string
        group_id:
          type: string
        discipline_id:
          type: string
        discipline_title:
          type: string
        ects:
          type: number
          description: Точна кількість кредитів ЄКТС дисципліни (numeric(3,1))
        status:
          type: string
          enum: [held, confirmed, expired, cancelled]
        version:
          type: integer
        created_at:
          type: string
          format: date-time
        expires_at:
          type: string
          format: date-time
        created_at_local:
          type: string
          description: Час створення у часовому поясі університету (Europe/Kyiv, ISO 8601)
        expires_at_local:
          type: string
          description: Час закінчення утримання місця у часовому поясі університету (Europe/Kyiv, ISO 8601)
        university_tz:
          type: string
          example: "Europe/Kyiv"
        instance_id:
          type: string
          example: "app-a"
        extra_server_field:
          type: string
          description: Додаткове поле для перевірки ігнорування невідомих полів клієнтом (О1.7)

    WebEnrollmentListResponse:
      type: object
      required: [items, next_cursor, limit, student_id, active_count, max_disciplines, active_ects, max_ects]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/WebEnrollmentResponse"
        next_cursor:
          type: [string, "null"]
          description: Непрозорий курсор для переходу до наступної сторінки або null, якщо досягнуто кінця списку (О1.5)
        limit:
          type: integer
        student_id:
          type: string
        active_count:
          type: integer
        max_disciplines:
          type: integer
        active_ects:
          type: number
        max_ects:
          type: number

    WebDisciplineGroup:
      type: object
      required: [id, discipline_id, group_code, seats, available, opens_at, closes_at, opens_at_local, closes_at_local, university_tz, closed, window_active]
      properties:
        id:
          type: string
        discipline_id:
          type: string
        group_code:
          type: string
        seats:
          type: integer
        available:
          type: integer
        opens_at:
          type: string
          format: date-time
        closes_at:
          type: string
          format: date-time
        opens_at_local:
          type: string
        closes_at_local:
          type: string
        university_tz:
          type: string
        closed:
          type: boolean
        window_active:
          type: boolean

    WebDiscipline:
      type: object
      required: [id, code, title, ects, groups]
      properties:
        id:
          type: string
        code:
          type: string
        title:
          type: string
        ects:
          type: number
        groups:
          type: array
          items:
            $ref: "#/components/schemas/WebDisciplineGroup"

    WebDisciplineListResponse:
      type: object
      required: [items, next_cursor]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/WebDiscipline"
        next_cursor:
          type: [string, "null"]

    CreateDpcEnrollmentRequest:
      type: object
      required: [student_id, group_id]
      properties:
        student_id:
          type: string
        group_id:
          type: string
        request_id:
          type: string
          format: uuid

    DpcEnrollmentAcceptedResponse:
      type: object
      required: [id, student_id, group_id, status, created_at]
      properties:
        id:
          type: string
          format: uuid
        student_id:
          type: string
        group_id:
          type: string
        status:
          type: string
          enum: [queued, processing, done, rejected, failed]
        created_at:
          type: string
          format: date-time

    DpcEnrollmentStatusResponse:
      type: object
      required: [id, student_id, group_id, status, created_at]
      properties:
        id:
          type: string
          format: uuid
        student_id:
          type: string
        group_id:
          type: string
        assigned_group_id:
          type: [string, "null"]
        recorded_in_roster:
          type: boolean
        status:
          type: string
          enum: [queued, processing, done, rejected, failed]
        rejection_reason:
          type: [string, "null"]
        created_at:
          type: string
          format: date-time
        started_at:
          type: [string, "null"]
          format: date-time
        finished_at:
          type: [string, "null"]
          format: date-time
        first_read_at:
          type: [string, "null"]
          format: date-time
        queue_wait_ms:
          type: [number, "null"]
        processing_time_ms:
          type: [number, "null"]
        delivery_wait_ms:
          type: [number, "null"]

    GroupSeatsResponse:
      type: object
      required: [group_id, discipline_title, seats, taken, free_seats, invariant_holds]
      properties:
        group_id:
          type: string
        discipline_title:
          type: string
        seats:
          type: integer
