# ==============================================================================
# Зразок конфігурації виробничого та тестового оточення (.env.example)
# Платформа: С10 «Запис на вибіркові дисципліни» (Web + РПО)
# ==============================================================================

# --- Виробниче / Штатне середовище (Production Environment) ---
# Ідентифікатор поточного вузла сервісу (app-a, app-b або найменування pod-а)
INSTANCE_ID=app-a

# Робоча база даних PostgreSQL (3НФ реляційна схема)
DB_CONNECTION_STRING=Host=dpc-c10-postgres;Port=5432;Database=dpc_c10;Username=dpc_user;Password=REPLACE_WITH_STRONG_DB_PASSWORD;Maximum Pool Size=50

# Виробничий Bearer-токен авторизації (згенерований криптографічно безпечним методом)
API_AUTH_TOKEN=REPLACE_WITH_GENERATED_SECRET_TOKEN

# Параметри обробки та черги
QUEUE_CAPACITY=100
WORKERS=3
EXECUTION_MODEL=async_tasks
QUEUE_ENGINE=custom_monitor

# Сувора заборона тестових обходів та ручного скидання стенду у production
ALLOW_TEST_OVERRIDES=false
UNSAFE_MODE=false

# --- Тестове та ізольоване середовище (Test / CI Environment) ---
# Виділена тестова база даних (суворо відмінна від робочої dpc_c10; обов'язково містить 'test' у назві)
TEST_DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=dpc_c10_test;Username=dpc_user;Password=dpc_password;Maximum Pool Size=50

# Виділений ізольований тестовий токен (жодним чином не збігається з виробничим API_AUTH_TOKEN)
TEST_API_AUTH_TOKEN=test-c10-isolated-bearer-token
